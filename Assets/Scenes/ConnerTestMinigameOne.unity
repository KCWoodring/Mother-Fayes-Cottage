--- !u!114 &1010407377
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1010407375}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Ingredients:

    1 pound of ground beef

    1 honeydew melon

    1 pumpkin

    A small bowl of blueberries

    1 cup of water

    A spoonful of rice


    Instructions:

    Chop the melon and pumpkin into small chunks (one at a time), then puree them in a food processor. Set the purees aside for later.

    Drag the beef into the pan, then click on it repeatedly to chop it into bits. Cook the beef thoroughly until brown, then take off the stove to assemble the rest of the ingredients.

    Add the rice, water, the purees (one at a time), and finally the blueberries, in that order.

    Done!

'
  m_isRightToLeft: 0
